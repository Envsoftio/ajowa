{
  "name": "AJOWA",
  "short_name": "AJOWA",
  "description": "AJOWA society management dashboard.",
  "start_url": "/launch.html",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#0645c3",
  "orientation": "portrait",
  "shortcuts": [
    {
      "name": "Dues",
      "short_name": "Dues",
      "url": "/my/dues",
      "icons": [{ "src": "/icons/ajowa-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Service Requests",
      "short_name": "Requests",
      "url": "/my/service-requests",
      "icons": [{ "src": "/icons/ajowa-icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Notices",
      "short_name": "Notices",
      "url": "/my/notices",
      "icons": [{ "src": "/icons/ajowa-icon-192.png", "sizes": "192x192" }]
    }
  ],
  "icons": [
    {
      "src": "/ajowa-icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/icons/ajowa-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/ajowa-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icons/ajowa-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
